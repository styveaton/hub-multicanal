// Schéma Sprint 1 (US1) : comptes, organisations, rôles, invitations.
// Les modèles produits, stock, canaux et commandes arrivent aux Sprints 2 à 4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  EMPLOYEE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String?
  passwordHash   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  memberships    Membership[]
  sentInvites    Invitation[]    @relation("InvitedBy")
  sessions       Session[]
  passwordResets PasswordReset[]
}

// Un compte vendeur (l'entreprise). Porte l'abonnement Stripe (Sprint 6).
model Organization {
  id               String              @id @default(cuid())
  name             String
  stripeCustomerId String?             @unique
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  memberships      Membership[]
  invitations      Invitation[]
  sessions         Session[]
  products         Product[]
  photos           ProductPhoto[]
  skus             Sku[]
  connections      ChannelConnection[]
  oauthStates      OAuthState[]
  listings         ChannelListing[]
  orders           Order[]
  syncLogs         SyncLog[]
  devices          ExtensionDevice[]
  browserTasks     BrowserTask[]
  consents         ChannelConsent[]
}

// Session de connexion : le cookie porte un jeton aléatoire, seul son hash est stocké.
// Code à 6 chiffres envoyé par email pour changer de mot de passe (valable 2 minutes).
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Session {
  id             String       @id @default(cuid())
  tokenHash      String       @unique
  userId         String
  organizationId String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Membership {
  id             String       @id @default(cuid())
  role           Role
  userId         String
  organizationId String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String           @id @default(cuid())
  email          String
  role           Role             @default(EMPLOYEE)
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  organizationId String
  invitedById    String
  createdAt      DateTime         @default(now())
  acceptedAt     DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId, status])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Sprint 2 (US4-US5) : fiche produit maître, photos, variantes, réglages par canal
// ---------------------------------------------------------------------------

enum ProductMode {
  SINGLE // article unique : quantité 1
  VARIANTS // plusieurs variantes, chacune avec SKU, prix et quantité
}

enum ProductCondition {
  NEW
  USED_LIKE_NEW
  USED_GOOD
  USED_FAIR
}

enum Channel {
  EBAY
  AMAZON
  TIKTOK_SHOP
  WALMART
  ETSY
  SHOPIFY
  WOOCOMMERCE
  FACEBOOK_MARKETPLACE
  MERCARI
  POSHMARK
  DEPOP
  VINTED
  GRAILED
}

enum PriceMode {
  BASE // prix de la fiche maître
  FIXED // prix fixe pour ce canal (article unique seulement)
  PERCENT // prix maître +/- un pourcentage
}

model Product {
  id             String           @id @default(cuid())
  organizationId String
  title          String
  description    String
  brand          String?
  condition      ProductCondition @default(NEW)
  mode           ProductMode
  currency       String           @default("USD")
  // Article unique : prix en centimes (quantité toujours 1, SKU dans Sku).
  priceCents     Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  photos         ProductPhoto[]
  variants       ProductVariant[]
  channels       ProductChannel[]
  skus           Sku[]
  listings       ChannelListing[]

  @@index([organizationId, updatedAt])
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  // Ex. {"Taille": "M", "Couleur": "Rouge"}
  attributes Json
  priceCents Int
  // Le stock est porté par le SKU (Sku.quantity), source unique pour tous les canaux.
  position   Int
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        Sku?

  @@index([productId])
}

// Registre des SKU : garantit qu'un SKU est unique dans toute la boutique
// (article unique ou variante), ce dont la synchronisation des canaux a besoin.
model Sku {
  id             String          @id @default(cuid())
  organizationId String
  code           String
  productId      String
  variantId      String?         @unique
  // Stock central : modifié uniquement sous verrou (vente, annulation, ajustement).
  quantity       Int             @default(0)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([productId])
}

// Photo envoyée par la boutique. Sans produit tant qu'elle n'est pas rattachée à une fiche.
model ProductPhoto {
  id             String       @id @default(cuid())
  organizationId String
  productId      String?
  storageKey     String       @unique
  contentType    String
  sizeBytes      Int
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([organizationId, productId])
}

// Adaptation de la fiche pour un canal (US5) : titre, catégorie, prix.
model ProductChannel {
  id         String    @id @default(cuid())
  productId  String
  channel    Channel
  enabled    Boolean   @default(true)
  title      String?
  category   String?
  priceMode  PriceMode @default(BASE)
  priceCents Int? // si FIXED
  percentBps Int? // si PERCENT, en centièmes de % (1050 = +10,5 %)
  // Champs propres au canal (ex. Depop : rayon, type de produit, taille, frais de port).
  details    Json?
  updatedAt  DateTime  @updatedAt
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, channel])
}

// ---------------------------------------------------------------------------
// Connexion des canaux et publication (Depop en premier, puis eBay au Sprint 3)
// ---------------------------------------------------------------------------

enum ConnectionStatus {
  CONNECTED
  NEEDS_REAUTH // jeton refusé ou expiré : le propriétaire doit reconnecter le compte
}

// Compte vendeur relié à la boutique. Les jetons sont chiffrés (AES-256-GCM).
model ChannelConnection {
  id                   String           @id @default(cuid())
  organizationId       String
  channel              Channel
  status               ConnectionStatus @default(CONNECTED)
  externalAccountId    String?
  externalUsername     String?
  accessTokenEnc       String
  refreshTokenEnc      String?
  accessTokenExpiresAt DateTime?
  scopes               String           @default("")
  // Réglages propres au canal (ex. Depop : État d'expédition).
  settings             Json             @default("{}")
  // Webhook de commandes enregistré chez le canal (secret chiffré, renvoyé une seule fois).
  webhookId            String?
  webhookSecretEnc     String?
  // Relevé de secours : commandes importées jusqu'à cette date.
  ordersSyncedAt       DateTime?
  connectedById        String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, channel])
}

// Demande de connexion OAuth en cours (protection CSRF + vérificateur PKCE), valable 10 minutes.
model OAuthState {
  id              String       @id @default(cuid())
  stateHash       String       @unique
  organizationId  String
  userId          String
  channel         Channel
  codeVerifierEnc String
  // Données propres au canal (ex. Shopify : boutique *.myshopify.com visée).
  extra           Json?
  expiresAt       DateTime
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum ListingStatus {
  PENDING // publication demandée, en attente du worker
  LISTED // en ligne sur le canal
  ERROR // refusée par le canal ou erreur technique
  REMOVED // retirée du canal
}

// Une annonce sur un canal, par SKU (article unique ou variante).
model ChannelListing {
  id               String        @id @default(cuid())
  organizationId   String
  productId        String?
  channel          Channel
  skuCode          String
  status           ListingStatus @default(PENDING)
  externalId       String?
  // Shopify / WooCommerce : produit parent (une annonce par SKU = une variante du produit).
  externalParentId String?
  // Données techniques du canal (ex. Shopify : article de stock, empreinte des photos envoyées).
  externalMeta     Json?
  externalUrl      String?
  errorCode        String?
  errorMessage     String?
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product          Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([organizationId, channel, skuCode])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Sprint 4 (US8-US9) : commandes, stock central et journal de synchronisation
// ---------------------------------------------------------------------------

enum OrderSource {
  CHANNEL // importée d'un canal (webhook ou relevé de secours)
  MANUAL // saisie dans OmniList (vente en direct, canal pas encore branché)
}

enum OrderStatus {
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

// Commande d'un canal ou vente saisie. Idempotence : un seul enregistrement par commande du canal.
model Order {
  id              String       @id @default(cuid())
  organizationId  String
  channel         Channel?
  source          OrderSource
  externalOrderId String
  status          OrderStatus  @default(PAID)
  buyerName       String?
  // Identifiant de l'acheteur chez le canal (eBay : pseudo), pour effacer ses données à sa demande.
  buyerRef        String?
  currency        String       @default("USD")
  totalCents      Int
  placedAt        DateTime
  // Stock déjà remis en place après annulation ou remboursement.
  restockedAt     DateTime?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines           OrderLine[]

  @@unique([organizationId, channel, externalOrderId])
  @@index([organizationId, placedAt])
  @@index([channel, buyerRef])
}

model OrderLine {
  id             String  @id @default(cuid())
  orderId        String
  skuCode        String
  productId      String?
  title          String
  quantity       Int
  unitPriceCents Int
  // Partie de la quantité vendue alors que le stock était déjà à 0 (double vente).
  oversoldQty    Int     @default(0)
  // SKU inconnu dans OmniList : rien à décompter.
  matched        Boolean @default(true)
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum SyncLogType {
  SALE // stock diminué par une vente
  RESTOCK // stock remis après annulation ou remboursement
  ADJUSTMENT // stock corrigé à la main
  OVERSOLD // vente alors que le stock était à 0
  UNKNOWN_SKU // vente d'un SKU inconnu
  CHANNEL_UPDATE // annonce mise à jour ou retirée sur un canal
  CHANNEL_ERROR // échec d'envoi vers un canal
}

// Journal de synchronisation consultable (US8).
model SyncLog {
  id             String       @id @default(cuid())
  organizationId String
  type           SyncLogType
  channel        Channel?
  skuCode        String?
  productId      String?
  orderId        String?
  delta          Int?
  quantityAfter  Int?
  message        String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// Extension « OmniList Assistant » : sites sans API (Poshmark, Mercari, Facebook, Grailed).
// L'extension prépare le formulaire du site ; le vendeur clique lui-même sur le bouton final.
// Voir docs/PLAN-EXTENSION.md.
// ---------------------------------------------------------------------------

// Navigateur relié à la boutique. Le jeton (affiché une seule fois) est stocké haché.
model ExtensionDevice {
  id               String        @id @default(cuid())
  organizationId   String
  userId           String
  name             String
  tokenHash        String        @unique
  lastSeenAt       DateTime?
  extensionVersion String?
  revokedAt        DateTime?
  createdAt        DateTime      @default(now())
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks            BrowserTask[]

  @@index([organizationId])
}

// Accord du vendeur pour un site assisté, avec les risques expliqués. Pause possible (alerte du site).
model ChannelConsent {
  id             String       @id @default(cuid())
  organizationId String
  channel        Channel
  // Version du texte d'accord accepté : un nouveau texte demande un nouvel accord.
  version        Int
  acceptedById   String
  acceptedAt     DateTime     @default(now())
  // Plafond de publications par jour, réglable à la baisse seulement.
  dailyCap       Int
  pausedAt       DateTime?
  pauseReason    String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, channel])
}

// Interrupteur par site, pour tous les vendeurs (site modifié, demande de la plateforme…).
model SiteSwitch {
  channel          Channel  @id
  enabled          Boolean  @default(true)
  // Version des repères de page attendus par l'extension.
  selectorsVersion Int      @default(1)
  reason           String?
  updatedAt        DateTime @updatedAt
}

enum BrowserTaskType {
  LIST // publier l'annonce
  UPDATE // modifier prix, titre, description
  DELIST // retirer l'annonce (vendue ailleurs, rupture, fiche supprimée)
}

enum BrowserTaskStatus {
  QUEUED // en attente du vendeur
  CLAIMED // ouverte dans le navigateur
  DONE
  FAILED
  CANCELLED // remplacée par une tâche plus récente, ou accord retiré
}

// Tâche à faire dans le navigateur du vendeur. Une seule tâche ouverte par SKU et par site.
model BrowserTask {
  id             String            @id @default(cuid())
  organizationId String
  channel        Channel
  type           BrowserTaskType
  status         BrowserTaskStatus @default(QUEUED)
  productId      String?
  skuCode        String
  title          String
  attempts       Int               @default(0)
  deviceId       String?
  claimedAt      DateTime?
  completedAt    DateTime?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device         ExtensionDevice?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, channel, skuCode])
  @@index([channel, completedAt])
}
