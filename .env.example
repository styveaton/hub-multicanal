# Copier en .env pour le developpement local (ne jamais committer .env).
NODE_ENV=development
APP_ENV=local

DATABASE_URL=postgresql://hub:hub@localhost:5433/hub
# Base dédiée aux tests (vidée à chaque test). Préparer avec : npm run db:test:prepare
TEST_DATABASE_URL=postgresql://hub:hub@localhost:5433/hub_test
REDIS_URL=redis://localhost:6379

API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
SESSION_TTL_DAYS=30
INVITATION_TTL_DAYS=7
SESSION_SECRET=change-me-with-32-random-characters

# Emails (Mailpit en local)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Hub Multi-canal <no-reply@localhost>"

# Stripe : cles de MODE TEST uniquement (sk_test_..., whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Canaux (Sprints 3 et 5) : a remplir quand les acces sont obtenus
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
AMAZON_SPAPI_CLIENT_ID=
AMAZON_SPAPI_CLIENT_SECRET=
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=

# Cle de chiffrement des jetons OAuth des canaux (32 octets en base64)
TOKEN_ENCRYPTION_KEY=
