# Copier en .env pour le developpement local (ne jamais committer .env).
NODE_ENV=development
APP_ENV=local

# Port Windows de la base Docker. Si vous le changez, mettez le même port dans les deux URL ci-dessous.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://hub:hub@localhost:5433/hub
# Base dédiée aux tests (vidée à chaque test). Préparer avec : npm run db:test:prepare
TEST_DATABASE_URL=postgresql://hub:hub@localhost:5433/hub_test
REDIS_URL=redis://localhost:6379

API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
SESSION_TTL_DAYS=30
INVITATION_TTL_DAYS=7
SESSION_SECRET=change-me-with-32-random-characters

# Emails (Mailpit en local)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="OmniList <no-reply@localhost>"

# Stripe : cles de MODE TEST uniquement (sk_test_..., whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Canaux (Sprints 3 et 5) : a remplir quand les acces sont obtenus
# eBay : fake = faux eBay intégré (essai local sans clés) ; sandbox = eBay de test ; production = vrai eBay.
# sandbox et production demandent aussi EBAY_RUNAME (adresse de retour déclarée chez eBay).
EBAY_ENV=fake
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
# Avis « suppression de compte » : même jeton que dans le portail eBay (32 à 80 caractères).
EBAY_VERIFICATION_TOKEN=
AMAZON_SPAPI_CLIENT_ID=
AMAZON_SPAPI_CLIENT_SECRET=
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=

# Depop (Selling API). fake = faux Depop intégré pour essayer sans clés ; staging / production une fois l'accès obtenu.
DEPOP_ENV=fake
DEPOP_CLIENT_ID=
DEPOP_CLIENT_SECRET=
# Shopify : fake = faux Shopify intégré ; live = application Shopify Partner (clés ci-dessous)
SHOPIFY_ENV=fake
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# WooCommerce : fake = faux site intégré ; live = vrais sites WordPress des marchands (clés saisies dans OmniList)
WOO_ENV=fake
# Adresse publique de l'API (Depop y télécharge les photos). Par défaut : WEB_URL + /api
PUBLIC_API_URL=
# Secret des liens signés vers les photos (dérivé de SESSION_SECRET en local s'il est vide)
MEDIA_URL_SECRET=

# Cle de chiffrement des jetons OAuth des canaux (32 octets en base64). Vide en local : derivee de SESSION_SECRET.
# Generer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Photos produits : stockage compatible S3 (SeaweedFS en local via Docker)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=omnilist-media
S3_ACCESS_KEY_ID=hub
S3_SECRET_ACCESS_KEY=hub-s3-secret
S3_FORCE_PATH_STYLE=true
