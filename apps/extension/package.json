{
  "name": "@hub/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Extension Chrome « OmniList Assistant » : prépare les annonces des sites sans API, le vendeur valide chaque action.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:dev": "tsc -p tsconfig.json && node scripts/copy-static.mjs --dev"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287"
  }
}
