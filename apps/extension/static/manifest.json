{
  "manifest_version": 3,
  "name": "OmniList Assistant",
  "version": "0.1.0",
  "description": "Prépare vos annonces OmniList sur les sites sans API. Vous validez chaque action vous-même.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "OmniList Assistant",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://omnilist.1handbiz.com/*", "http://localhost:3000/*"],
  "content_scripts": [
    {
      "matches": ["https://omnilist.1handbiz.com/*", "http://localhost:3000/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
