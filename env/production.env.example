# Variables de l'environnement production. Les vraies valeurs vont dans le gestionnaire
# de secrets de l'hebergeur, jamais dans ce depot.
NODE_ENV=production
APP_ENV=production
DATABASE_URL=
REDIS_URL=
API_PORT=4000
WEB_URL=https://<domaine-production>
# Adresse interne de l API, utilisée par le front (proxy /api)
API_URL=
SESSION_SECRET=
SMTP_HOST=
SMTP_PORT=587
MAIL_FROM=
# Stripe : cle sk_live_... (mode live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
AMAZON_SPAPI_CLIENT_ID=
AMAZON_SPAPI_CLIENT_SECRET=
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
DEPOP_ENV=production
DEPOP_CLIENT_ID=
DEPOP_CLIENT_SECRET=
# Adresse publique de l'API, accessible depuis internet (Depop télécharge les photos)
PUBLIC_API_URL=
# Obligatoires hors local
MEDIA_URL_SECRET=
TOKEN_ENCRYPTION_KEY=
# Photos : S3 compatible (laisser S3_ENDPOINT vide pour AWS S3 ; sinon URL de R2, Scaleway…)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
