# Variables de l'environnement production. Les vraies valeurs vont dans le gestionnaire
# de secrets de l'hebergeur, jamais dans ce depot.
NODE_ENV=production
APP_ENV=production
DATABASE_URL=
REDIS_URL=
API_PORT=4000
# Relais qui ajoutent l'IP du visiteur à X-Forwarded-For (nginx = 1 ; Next.js /api ne compte pas). Sert à la limite de requêtes.
TRUST_PROXY_HOPS=1
WEB_URL=https://<domaine-production>
# Adresse interne de l API, utilisée par le front (proxy /api)
API_URL=
SESSION_SECRET=
SMTP_HOST=
SMTP_PORT=587
MAIL_FROM=
# Stripe : cle sk_live_... (mode live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# eBay : fake = faux eBay intégré (essai local sans clés) ; sandbox = eBay de test ; production = vrai eBay.
# sandbox et production demandent aussi EBAY_RUNAME (adresse de retour déclarée chez eBay).
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
# Avis « suppression de compte » : même jeton que dans le portail eBay (32 à 80 caractères).
EBAY_VERIFICATION_TOKEN=
# Etsy : fake = faux Etsy intégré (essai local) ; live = vraie Open API v3 (application Etsy approuvée).
# Adresse de retour à déclarer dans l'application Etsy : <WEB_URL>/api/channels/etsy/callback
ETSY_ENV=live
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
AMAZON_SPAPI_CLIENT_ID=
AMAZON_SPAPI_CLIENT_SECRET=
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
DEPOP_ENV=production
DEPOP_CLIENT_ID=
DEPOP_CLIENT_SECRET=
SHOPIFY_ENV=live
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
WOO_ENV=live
# Adresse publique de l'API, accessible depuis internet (Depop télécharge les photos)
PUBLIC_API_URL=
# Obligatoires hors local
MEDIA_URL_SECRET=
TOKEN_ENCRYPTION_KEY=
# Photos : S3 compatible (laisser S3_ENDPOINT vide pour AWS S3 ; sinon URL de R2, Scaleway…)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
